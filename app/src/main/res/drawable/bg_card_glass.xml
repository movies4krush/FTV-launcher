<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://android.com">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#66FFFFFF"
                android:endColor="#26FFFFFF" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2.5dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#331E222D"
                android:endColor="#1A12141C" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
